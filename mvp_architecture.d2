vars: {
  d2-config: {
    layout-engine: elk
  }
}

LocalDevMachine: "Local Developer Workstation (localhost)" {
  tooltip: "«device»"
  style.fill: "#F8FAFC"
  style.stroke: "#64748B"
  style.border-radius: 8

  ViteDevServer: "Vite Dev Server\n(Port 5173)" {
    tooltip: "«execution environment»"
    style.fill: "#EFF6FF"
    style.stroke: "#3B82F6"

    ReactSPA: "React SPA\n(Supply Chain Cockpit)" {
      tooltip: "«artifact»"
      style.fill: "#EFF6FF"
      style.stroke: "#3B82F6"
    }

    StaticJSONDB: "Static JSON Files\n(threatRegistry.json\nknowledgeGraph.json)" {
      shape: cylinder
      tooltip: "«database»"
      style.fill: "#FEFBF0"
      style.stroke: "#F59E0B"
    }
  }

  FastAPIServer: "FastAPI Web Server\n(Uvicorn, Port 8000)" {
    tooltip: "«execution environment»"
    style.fill: "#F0FDF4"
    style.stroke: "#15803D"
    style.border-radius: 6

    main_py: "main.py Orchestrator" {
      tooltip: "«component»"
      style.fill: "#F0FDF4"
      style.stroke: "#15803D"
    }

    collect_signals_py: "collect_signals.py\n(Synthetic Signal Gen)" {
      tooltip: "«component»"
      style.fill: "#F0FDF4"
      style.stroke: "#15803D"
    }

    analyze_signals_py: "analyze_signals.py\n(JSON Structuring)" {
      tooltip: "«component»"
      style.fill: "#F0FDF4"
      style.stroke: "#15803D"
    }

    generate_mitigation_py: "generate_mitigation_and_validation.py\n(Playbook Generator)" {
      tooltip: "«component»"
      style.fill: "#F0FDF4"
      style.stroke: "#15803D"
    }
  }
}

ExtSaaS: "External SaaS Services" {
  tooltip: "«infrastructure»"
  style.fill: "#FAF5FF"
  style.stroke: "#7C3AED"
  style.border-radius: 8

  OpenAIAPI: "OpenAI Platform (SaaS)" {
    tooltip: "«infrastructure»"
    style.fill: "#F8FAFC"
    style.stroke: "#64748B"

    GPTModel: "GPT Model (GPT-5.5 / GPT-4o)\n(Synthetic Gen & Text RAG)" {
      tooltip: "«component»"
      style.fill: "#F0FDF4"
      style.stroke: "#15803D"
    }
  }
}

# --- Connections & Flows ---

LocalDevMachine.ViteDevServer.ReactSPA -> LocalDevMachine.FastAPIServer.main_py: "User Trigger / REST Requests\n(HTTP: 8000)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.main_py -> LocalDevMachine.ViteDevServer.StaticJSONDB: "Read/Write Threat Registry JSON\n(Local File I/O)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.main_py -> LocalDevMachine.FastAPIServer.collect_signals_py: "1. Trigger Signal Ingestion\n(Local Function Call)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.main_py -> LocalDevMachine.FastAPIServer.analyze_signals_py: "2. Structurize Raw Signal\n(Local Function Call)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.main_py -> LocalDevMachine.FastAPIServer.generate_mitigation_py: "3. Generate Playbooks\n(Local Function Call)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.collect_signals_py -> ExtSaaS.OpenAIAPI.GPTModel: "Generate Synthetic Disruption\n(HTTPS: 443)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.analyze_signals_py -> ExtSaaS.OpenAIAPI.GPTModel: "Extract JSON Fields\n(HTTPS: 443)" {
  style.stroke: "#475569"
}

LocalDevMachine.FastAPIServer.generate_mitigation_py -> ExtSaaS.OpenAIAPI.GPTModel: "Generate Playbook/Validation Steps\n(HTTPS: 443)" {
  style.stroke: "#475569"
}

LocalDevMachine.ViteDevServer.ReactSPA -> LocalDevMachine.ViteDevServer.StaticJSONDB: "Load Offline Threat Registry\n(Local HTTP Fetch)" {
  style.stroke: "#475569"
}
